# Copy to .env to override. All variables are optional.

# MapLibre style JSON URL (version 8). Tried first; if unset, unreachable or invalid, the app
# falls back to OpenFreeMap Dark, then CARTO Dark Matter, then a plain offline background.
# Any 3D content in the style (extrusions, terrain, hillshade, globe) is stripped.
# Do not put API keys here if the app is deployed publicly: this value is sent to the browser.
MAP_STYLE_URL=

# Server-side weather provider id. Default 'open-meteo' (keyless, no secrets needed).
# An official Maldives Meteorological Service adapter can register its own id later.
WEATHER_PROVIDER=
