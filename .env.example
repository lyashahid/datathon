# OPTIONAL ONLY. A fresh clone works without this file or any environment variables.
# Defaults below are already defined in the application and npm start launcher.
# Copy to .env only when deliberately overriding a default.

# Frontend server-to-backend connection; never exposed to browser JavaScript.
MOBILITY_BACKEND_URL=http://127.0.0.1:8000

# Local Vela place/review service is anonymous by default.
# If securing it, set the same private key for the proxy and backend.
# Keep actual keys in ignored local .env files; never commit them.
VELA_API_KEY=
# npm start prepares Chromium for the browser review collector automatically.
VELA_BROWSER_ENABLED=true

# Build-time only: leave unset for local npm start. Docker sets /apps/datathon.
# Changing this requires rebuilding the frontend; it is not a credential.
# PUBLIC_BASE_PATH=/apps/datathon

# More optional backend settings: backend/.env.example and backend/README.md.
# Data paths default to this checkout; no machine-specific paths are needed.
