# Copy to .env to override. All variables are optional.

# MapLibre style JSON URL (version 8). Tried first; if unset, unreachable or invalid, the app
# falls back to OpenFreeMap Dark, then CARTO Dark Matter, then a plain offline background.
# Any 3D content in the style (extrusions, terrain, hillshade, globe) is stripped.
# Do not put API keys here if the app is deployed publicly: this value is sent to the browser.
MAP_STYLE_URL=

# Server-side weather provider id. Default 'open-meteo' (keyless, no secrets needed).
# An official Maldives Meteorological Service adapter can register its own id later.
WEATHER_PROVIDER=

# Compatibility infrastructure/routes endpoints. 'public' is the default.
# 'sample' and 'processed' are explicit demo / fixture sources. The policy atlas always uses
# the locally cached versioned public planning bundle, independent of this variable.
BASELINE_SOURCE=public

# Auxiliary observations, separate from policy access/cost/carbon calculations.
# Both default to true. Setting false removes that dataset from server responses.
ENABLE_VESSEL_DATA=true
ENABLE_FLIGHT_PASSENGER_DATA=true

# Optional issued FollowMe API key for the public-vessel refresh adapter (server only).
# Never prefix this key with VITE_ or PUBLIC_. Local cached snapshots work without a key.
FOLLOWME_API_KEY=

# No map key is required: OpenFreeMap streets and EOX 2025 satellite work without one.
# EOX satellite is a 10 m mosaic, free for noncommercial use under CC BY-NC-SA 4.0.
# https://cloudless.eox.at/pricing ; credit/license stay visible on the map.
# Optional MapTiler satellite upgrade: a configured key selects MapTiler instead of EOX.
# VITE variables are public browser configuration; restrict this provider key by domain.
# Confirm the provider's current usage/license plan before deploying satellite imagery.
# Policy briefs always capture the local atlas, without satellite imagery.
VITE_MAPTILER_KEY=
