# Optional overrides only. The checked-in defaults run without this file.
# Copy to backend/.env only when you want to customize a setting.

MOBILITY_ENVIRONMENT=development
MOBILITY_HOST=127.0.0.1
MOBILITY_PORT=8000
MOBILITY_LOG_LEVEL=INFO

# Relative paths resolve from backend/, regardless of the shell's directory.
MOBILITY_DATA_DIR=data
MOBILITY_PUBLIC_DATA_DIR=../data/public

# Optional server-side shared computation cache. Blank keeps local caching.
# Real credentials belong only in ignored backend/.env, never in browser settings.
# Prisma-style ?schema=public is accepted; TLS is required automatically.
MOBILITY_DATABASE_URL=
MOBILITY_COMPUTED_CACHE_MEMORY_MB=64
MOBILITY_COMPUTED_CACHE_DISK_MB=512
MOBILITY_COMPUTED_CACHE_MAX_ENTRIES=256
MOBILITY_COMPUTED_CACHE_PREWARM=true

MOBILITY_LIVE_AIRCRAFT_ENABLED=true
MOBILITY_LIVE_VESSEL_ENABLED=true
MOBILITY_LIVE_FOLLOWME_ENABLED=true
# RTL's bus feed requires separate provider authorization; no credentials ship.
MOBILITY_LIVE_BUS_ENABLED=false
MOBILITY_LIVE_CACHE_TTL_SECONDS=60
MOBILITY_LIVE_REQUEST_TIMEOUT_SECONDS=10
MOBILITY_LIVE_POLL_INTERVAL_SECONDS=60

# Chromium is installed by the root setup command. No upstream API key is needed.
VELA_BROWSER_ENABLED=true
VELA_REQUEST_TIMEOUT=25
VELA_MAX_CONCURRENT_REQUESTS=8
VELA_RATE_LIMIT_PER_MINUTE=60
VELA_CACHE_TTL=120

# Optional caller authentication for a custom deployment. Keep real keys private.
# If you enable this, configure the same VELA_API_KEY for the frontend server.
# VELA_API_KEY=
# VELA_CORS_ORIGINS=
