{
	"name": "mobility-sandbox-mv",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"start": "node scripts/start.mjs",
		"dev": "node scripts/dev.mjs",
		"dev:frontend": "vite dev",
		"dev:backend": "uv run --directory backend uvicorn app.main:app --host 127.0.0.1 --port 8000",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check src scripts README.md package.json vite.config.ts tsconfig.json && eslint src scripts vite.config.ts",
		"format": "prettier --write src scripts README.md package.json vite.config.ts tsconfig.json",
		"test": "vitest run",
		"test:startup": "node --test scripts/runtime.test.mjs scripts/production.test.mjs",
		"precompute": "uv run --directory backend python -m app.cli.precompute --include-planning",
		"test:backend": "uv run --directory backend pytest",
		"lint:backend": "uv run --directory backend ruff check app tests",
		"test:browser": "node scripts/verify-browser.mjs",
		"test:browser:accessibility": "node scripts/verify-island-accessibility.mjs",
		"test:browser:country": "node scripts/verify-country-map-journey.mjs",
		"test:browser:capital": "node scripts/verify-capital-map-start.mjs",
		"test:browser:connections": "node scripts/verify-island-connections.mjs",
		"test:browser:proposal-experience": "node scripts/verify-proposal-experience.mjs",
		"test:browser:map-controls": "node scripts/verify-map-floating-controls.mjs",
		"test:browser:navigation": "node scripts/verify-restored-navigation.mjs",
		"test:policy-api": "node scripts/verify-policy-api.mjs",
		"test:browser:forecasts": "node scripts/verify-forecast-data-browser.mjs",
		"test:browser:planning": "node scripts/verify-planning-browser.mjs",
		"test:browser:places": "node scripts/verify-places-browser.mjs",
		"test:browser:map": "node scripts/verify-map-context-browser.mjs",
		"test:browser:delivery": "node scripts/verify-delivery-browser.mjs",
		"test:browser:timetables": "node scripts/verify-timetable-import-browser.mjs",
		"test:browser:map-legibility": "node scripts/verify-map-legibility-browser.mjs",
		"test:browser:map-first-conditions": "node scripts/verify-map-first-conditions-browser.mjs",
		"test:browser:map-first-places": "node scripts/verify-map-first-places-browser.mjs",
		"test:browser:map-focus": "node scripts/verify-map-place-focus.mjs",
		"test:browser:bus-vehicles": "node scripts/verify-bus-vehicle-map.mjs",
		"test:browser:unified-policy-journey": "node scripts/verify-unified-policy-journey.mjs",
		"test:browser:policy-drag": "node scripts/verify-policy-native-drag.mjs",
		"test:browser:map-transport": "node scripts/verify-map-transport-planning.mjs",
		"test:browser:map-comparison": "node scripts/verify-proposal-map-comparison.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"bits-ui": "^2.19.5",
		"maplibre-gl": "^6.12.0"
	}
}
