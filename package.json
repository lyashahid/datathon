{
	"name": "datathon",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:browser": "node scripts/verify-policy-browser.mjs",
		"ingest": "node scripts/ingest.ts",
		"ingest:fixtures": "node scripts/ingest.ts",
		"data:setup": "node scripts/public-data-run.mjs setup",
		"data:fetch": "node scripts/public-data-run.mjs fetch",
		"data:prepare": "node scripts/public-data-run.mjs prepare",
		"data:validate": "node scripts/public-data-run.mjs validate",
		"data:audit-stops": "node scripts/public-data-run.mjs audit-stops",
		"data:refresh": "node scripts/public-data-run.mjs all --refresh",
		"data:context": "node scripts/agency-context.mjs all",
		"data:context:fetch": "node scripts/agency-context.mjs fetch",
		"data:context:prepare": "node scripts/agency-context.mjs prepare",
		"data:context:validate": "node scripts/agency-context.mjs validate",
		"data:context:refresh": "node scripts/agency-context.mjs all --refresh",
		"data:followme": "node --env-file-if-exists=.env scripts/followme-context.mjs",
		"test:context": "node --test scripts/agency-context.test.mjs scripts/followme-context.test.mjs && vitest run src/lib/context src/lib/server/data/transportContextSource.test.ts",
		"data:policy-evidence": "node scripts/policy-evidence-run.mjs all",
		"data:policy-evidence:fetch": "node scripts/policy-evidence-run.mjs fetch",
		"data:policy-evidence:prepare": "node scripts/policy-evidence-run.mjs prepare",
		"data:policy-evidence:validate": "node scripts/policy-evidence-run.mjs validate",
		"data:operations": "node scripts/operations-data.mjs all",
		"data:operations:fetch": "node scripts/operations-data.mjs fetch",
		"data:operations:prepare": "node scripts/operations-data.mjs prepare",
		"data:operations:validate": "node scripts/operations-data.mjs validate",
		"data:operations:refresh": "node scripts/operations-data.mjs all",
		"data:prediction": "node scripts/public-data-run.mjs prediction",
		"test:prediction:sources": "node scripts/public-data-run.mjs prediction-test",
		"data:bus-capture": "node scripts/collect-bus-positions.mjs",
		"test:prediction": "node --test scripts/collect-bus-positions.test.mjs && vitest run src/lib/prediction src/lib/policy src/lib/server/data/predictionSource.test.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"bits-ui": "^2.19.5",
		"earcut": "^3.2.4",
		"echarts": "^6.1.0",
		"h3-js": "^4.5.0",
		"maplibre-gl": "^6.12.0",
		"pdf-lib": "^1.17.1",
		"polygon-clipping": "^0.15.7"
	}
}
