# Optional shared cache: set DATABASE_URL only in the protected server env file,
# then explicitly enable POSTGRES below. Memory/disk work without a database.
MOBILITY_ENVIRONMENT=production
MOBILITY_COMPUTED_CACHE_POSTGRES_ENABLED=false
MOBILITY_COMPUTED_CACHE_PREWARM=true
MOBILITY_LOG_LEVEL=INFO
VELA_API_KEY=REPLACE_WITH_THE_SAME_RANDOM_KEY_AS_FRONTEND
VELA_BROWSER_ENABLED=true
VELA_RATE_LIMIT_PER_MINUTE=60
MOBILITY_LIVE_AIRCRAFT_ENABLED=true
MOBILITY_LIVE_VESSEL_ENABLED=true
MOBILITY_LIVE_FOLLOWME_ENABLED=true
MOBILITY_LIVE_BUS_ENABLED=false
